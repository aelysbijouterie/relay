+++ b/src/app/api/auth/realtime-token/route.ts
@@ -0,0 +1,27 @@
+import { NextResponse } from 'next/server'
+import { cookies } from 'next/headers'
+
+export const dynamic = 'force-dynamic'
+
+interface SessionCookie {
+  access_token?: string
+}
+
+// Expose uniquement l'access_token Supabase de la session en cours, pour que
+// le client Realtime du navigateur puisse s'authentifier (supabase.realtime.setAuth).
+// Le cookie `relays-session` reste httpOnly : ce endpoint est le seul moyen pour
+// le JS client d'obtenir ce jeton, et uniquement celui de son propre navigateur
+// (le cookie httpOnly est transmis automatiquement par le navigateur, jamais lu
+// depuis document.cookie).
+export async function GET() {
+  const raw = cookies().get('relays-session')?.value
+  if (!raw) return NextResponse.json({ error: 'Non authentifié' }, { status: 401 })
+
+  try {
+    const session = JSON.parse(raw) as SessionCookie
+    if (!session.access_token) return NextResponse.json({ error: 'Non authentifié' }, { status: 401 })
+    return NextResponse.json({ access_token: session.access_token })
+  } catch {
+    return NextResponse.json({ error: 'Non authentifié' }, { status: 401 })
+  }
+}
