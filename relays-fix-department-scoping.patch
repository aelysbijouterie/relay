diff --git a/src/lib/tasks/visibility.ts b/src/lib/tasks/visibility.ts
new file mode 100644
index 0000000..1713e7d
--- /dev/null
+++ b/src/lib/tasks/visibility.ts
@@ -0,0 +1,29 @@
+import type { Task, Role } from '@/types'
+
+interface VisibilityContext {
+  userId: string
+  departmentId: string | null
+  role: Role
+}
+
+/**
+ * Réplique côté application la policy RLS "tasks_select" définie dans
+ * supabase/migrations/001_initial.sql. Cette policy n'a aucun effet sur
+ * les routes serveur de RELAYS car elles lisent toutes via le client
+ * admin (service role key), qui bypass RLS par construction — c'est donc
+ * ici, et uniquement ici, que la règle de visibilité doit être appliquée.
+ *
+ * Une tâche est visible si : l'utilisateur est admin, OU la tâche est
+ * dans son département, OU la tâche est partagée avec son département
+ * (inter-équipes, via task_departments), OU il est assigné à la tâche.
+ *
+ * Toute route qui renvoie une liste de tâches à un utilisateur doit
+ * filtrer avec cette fonction. Ne pas dupliquer cette logique ailleurs.
+ */
+export function isTaskVisibleTo(task: Task, user: VisibilityContext): boolean {
+  if (user.role === 'admin') return true
+  if (user.departmentId && task.department_id === user.departmentId) return true
+  if (user.departmentId && (task.extra_departments ?? []).some(d => d.id === user.departmentId)) return true
+  if ((task.assignees ?? []).some(a => a.id === user.userId)) return true
+  return false
+}
